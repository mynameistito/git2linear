{
  "name": "git2linear",
  "private": true,
  "type": "module",
  "scripts": {
    "alchemy:plan": "node node_modules/alchemy/bin/cli.js plan --stage production",
    "alchemy:deploy": "node node_modules/alchemy/bin/cli.js deploy --stage production",
    "typecheck": "tsrs --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "test": "vitest run",
    "build": "cf build",
    "deploy": "cf deploy",
    "deploy:check": "cf deploy --dry-run",
    "dev": "cf dev",
    "varlock:codegen": "varlock codegen",
    "varlock:alchemy:plan": "varlock run --filter=\"#deploy\" --inject=vars -- node node_modules/alchemy/bin/cli.js plan --stage production",
    "varlock:alchemy:preflight": "varlock run --filter=\"#deploy\" --inject=vars -- bun scripts/deployment-preflight.ts",
    "varlock:alchemy:deploy": "varlock run --filter=\"#deploy\" --inject=vars -- node node_modules/alchemy/bin/cli.js deploy --stage production",
    "varlock:provision": "varlock run --filter=\"#provision\" --inject=vars -- bun scripts/provision-secrets.ts",
    "varlock:operate": "varlock run --filter=\"#operator\" --inject=vars -- bun scripts/operate.ts",
    "knip": "knip"
  },
  "dependencies": {
    "effect": "4.1.1",
    "tsrs": "^0.20.1-ts7.1.0-beta"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.8",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@effect/platform-node": "4.1.1",
    "@effect/vitest": "4.1.1",
    "@types/bun": "latest",
    "alchemy": "2.0.0-beta.84",
    "cf": "^1.0.0-beta.26",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "ultracite": "8.1.0",
    "varlock": "^1.24.0",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
